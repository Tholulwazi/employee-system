/** New Subprogram LEAVECLL.
/**
/** :author tzu
/* TODO Enter your code here
DEFINE DATA
PARAMETER
1 #PERSONNEL-ID (A8)
1 #NAME (A20)
LOCAL USING EMPL0L01
LOCAL 
1 #PROGRAM (A8)
1 #LEAVE-S-DATE (A8)
1 REDEFINE #LEAVE-S-DATE 
  2 #LEAVE-S-DATN (N8)
1 #LEAVE-E-DATE (A8)
1 REDEFINE #LEAVE-E-DATE
  2 LEAVE-E-DATN (N8)

1 #DATE-A (A8)

1 #DATE-D (D)

1 #DATE-S (D)

1 #DATE-E (D)

1 #IND (N5)

1 #WEEKDAY-S (A10)
1 #WEEKDAY-E (A10)

1 #MONTH (A10)
1 #LEAVE (N5)
1 #DAYS (N7)
1 #DAYS-LEFT (N02.0)
1 #NUM-DAYS (N4)
1 #DAY-COUNTER (N5)
1 #CV-ALL (C)
1 #INDEX (N5)
1 #UPDATED-LEAVE-DUE (N2)
1 #UPDATED-LEAVE-TAKEN (N2)
END-DEFINE
#PROGRAM := *PROGRAM
MOVE (AD=I) TO #CV-ALL
MOVE *DATN TO #LEAVE-S-DATE /*remember to remove me here
FIND EMPLOYEES WITH PERSONEL-ID = #PERSONNEL-ID 

  COMPUTE #DAYS-LEFT := LEAVE-DUE - LEAVE-TAKEN

  IF #DAYS-LEFT = 0
    MOVE (AD=P) TO #CV-ALL
    INPUT  WITH TEXT 'YOU HAVE "0" DAYS LEFT IN YOUR ANNUAL LEAVE'
      USING MAP "LEAVE1"
    ESCAPE BOTTOM
  END-IF

  INPUT USING MAP "LEAVE1"

  IF *PF-KEY = 'PF3'
    ESCAPE BOTTOM
  END-IF


  MOVE EDITED #LEAVE-S-DATE TO #DATE-S (EM=YYYYMMDD)
  MOVE EDITED #LEAVE-E-DATE TO #DATE-E (EM=YYYYMMDD)

  MOVE EDITED #DATE-S (EM=N(10)) TO #WEEKDAY-S
*  MOVE EDITED #DATE-E (EM=N(10)) TO #WEEKDAY-E


  IF #WEEKDAY-S = 'Saturday' OR #WEEKDAY-S = 'Sunday'
    REINPUT FULL 'Leave start can non commence on saturday or Sunday !'
  END-IF
*  
  RESET #NUM-DAYS

*   ADD 1 TO #DAY-COUNTER 
*
  REPEAT

    IF #DATE-S GT #DATE-E
      ESCAPE BOTTOM
    END-IF

    ADD 1 TO #DATE-S
    MOVE EDITED #DATE-S (EM=N(10)) TO #WEEKDAY-S
    IF NOT (#WEEKDAY-S = 'Saturday' OR  = 'Sunday')
      ADD 1 TO #NUM-DAYS
    END-IF
*    
  END-REPEAT
  
*  RESET #DAYS-LEFT /*checked
      IF  #NUM-DAYS GT #DAYS-LEFT
    REINPUT FULL 'Number of days selected exceeds remaining ones'
      MARK *#LEAVE-S-DATE
      ELSE
        FOR #INDEX  = 3 TO 1
      STEP -1
*
    MOVE  LEAVE-START (#INDEX) TO LEAVE-START (#INDEX+1)
    MOVE #LEAVE-S-DATE.#LEAVE-S-DATN TO LEAVE-START (#INDEX)
*    
    MOVE LEAVE-END (#INDEX) TO LEAVE-END (#INDEX+1)
    MOVE #LEAVE-E-DATE.LEAVE-E-DATN TO LEAVE-END (#INDEX)
*    
  END-FOR
  END-IF
  
*  COMPUTE #LEAVE = (LEAVE-TAKEN + #NUM-DAYS)
   COMPUTE #UPDATED-LEAVE-TAKEN = LEAVE-TAKEN + #NUM-DAYS
  ASSIGN LEAVE-TAKEN = #UPDATED-LEAVE-TAKEN
  COMPUTE #DAYS-LEFT = #DAYS-LEFT - #NUM-DAYS
* *
MOVE (AD=P) TO #CV-ALL
  INPUT USING MAP "LEAVE1"

  UPDATE
 END OF TRANSACTION
END-FIND
END
