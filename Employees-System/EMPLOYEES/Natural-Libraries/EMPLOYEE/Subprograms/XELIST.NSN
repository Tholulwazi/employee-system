* >Natural Source Header 000000
* :Mode S
* :CP
* <Natural Source Header
/** New Subprogram XELIST.
/**
/** :author tzu
/* TODO Enter your code here
DEFINE DATA
* PARAMETER
* 1 #V-PERSONEL-ID (A8/1:16) /* NC
LOCAL USING EMPL0L01
LOCAL
/**
1 #V-PERSONEL-ID (A8/1:16) /* NC
1 #SEL (A1/1:16)
1 #RESTART-NAME (A20)
1 #LATE-RESTART-NAME (A20)
1 #RES-NAME (A4/1:16)
1 #CITY (A20/1:16)
1 #NAME (A20/1:16)
1 #FIRST-NAME (A20/1:16)
1 #MIDDLE-I (A20/1:16)
1 #LANG (A3/1:5)
1 #PERSONNEL-ID (A8/1:16)
1 #ADDRESS-LINE (A20/1:2)
1 #INDEX (N10)
1 #INDEX1 (N10)
1 #INDEX2 (N10)
1 #PROGRAM (A8) 
1 #GENDER (A1)
1 #RESTART-NAME2 (A20)
1 #REPOS-FLAG (A1)
1 #G-DESCRIPTION (A10)
1 #S-DESCRIPTION (A10)
1 #MARITAL-STATUS (A1)
1 #MARITAL (A1)

END-DEFINE
SET CONTROL 'MT'
MOVE *PROGRAM TO #PROGRAM

/**SETTING PF KEYS
SET KEY 
  PF1 = HELP
  PF3 NAMED 'Exit'
  PF5 NAMED 'ADD EMPL'
*   PF6 NAMED 'Leaves'
  PF8 NAMED 'Next'
/**
READ EMPLOYEES WITH REPOSITION
    BY NAME

    STARTING FROM #RESTART-NAME2
  ADD 1 TO #INDEX
  MOVE PERSONEL-ID       TO   #PERSONNEL-ID (#INDEX) 
  MOVE NAME              TO    #NAME(#INDEX)
  MOVE CITY              TO    #CITY(#INDEX)
  MOVE FIRST-NAME        TO    #FIRST-NAME(#INDEX)
  MOVE MIDDLE-I          TO   #MIDDLE-I(#INDEX)
  MOVE ADDRESS-LINE(1:2) TO  #ADDRESS-LINE (1:2)
/**

  IF #INDEX = 16
    REPEAT
      INPUT USING MAP "MENULST"

      DECIDE ON FIRST VALUE OF *PF-KEY
        VALUE 'PF3'
          ESCAPE MODULE
        VALUE 'ENTR'
          IGNORE
        VALUE 'PF8'
          ESCAPE BOTTOM
        VALUE 'PF5'
  FETCH RETURN'EMPLADD'
        NONE
          IGNORE
      END-DECIDE
/**
      FOR #INDEX1 = 1 TO 16
        DECIDE ON EVERY VALUE OF #SEL(#INDEX1)
          VALUE 'A' 
            CALLNAT "ADD" #PERSONNEL-ID (#INDEX1) 
          VALUE 'V'
          FETCH 'ADDEVEH' #PERSONNEL-ID (#INDEX1) 
*             CALLNAT "VEHLST"   #V-PERSONEL-ID  (#INDEX1) #NAME (#INDEX1)
          VALUE 'C'
            CALLNAT "CM-INFO" #PERSONNEL-ID(#INDEX1) #NAME(#INDEX1)
          VALUE 'P'
            CALLNAT "P-INFO" #PERSONNEL-ID(#INDEX1)
          #NAME(#INDEX1) #MIDDLE-I(#INDEX1) #FIRST-NAME(#INDEX1) #G-DESCRIPTION #S-DESCRIPTION
 
          VALUE 'L'
           CALLNAT 'leavecll' #PERSONNEL-ID(#INDEX1)  #NAME(#INDEX1)
          VALUE 'I'
          FETCH  'SAL-RY' #PERSONNEL-ID(#INDEX1) /*  #NAME(#INDEX1)
         NONE
            IGNORE
        END-DECIDE 
      END-FOR
      /**

      /*
      IF  #RESTART-NAME NE ' '
        MOVE #RESTART-NAME TO #LATE-RESTART-NAME #RESTART-NAME2
        RESET  #RESTART-NAME
        RESET #INDEX
        MOVE 'Y' TO #REPOS-FLAG
        ESCAPE BOTTOM
      END-IF
      /**
    END-REPEAT
    /**
    RESET #INDEX1
    IF #REPOS-FLAG = 'Y'
      RESET #REPOS-FLAG
      ESCAPE TOP REPOSITION
    END-IF
  END-IF



END-READ

IF #INDEX LE 16

  RESET

    #CITY (#INDEX + 1:16)

    #NAME (#INDEX + 1:16)
    #FIRST-NAME (#INDEX + 1:16)
    #PERSONNEL-ID (#INDEX + 1:16)
    #SEL (#INDEX + 1:16)

  INPUT MARK *#RESTART-NAME

    USING MAP "MENULST"

END-IF
END
