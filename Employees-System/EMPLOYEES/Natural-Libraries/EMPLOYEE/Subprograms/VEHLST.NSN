* >Natural Source Header 000000
* :Mode S
* :CP
* <Natural Source Header
/** New Subprogram 
/**
/** :author tzu
DEFINE DATA 
PARAMETER
1 #PERSONNEL-ID (A8)
1 #NAME(A20)
LOCAL USING VEH001
LOCAL USING EMPL0L01
LOCAL

1 #PROGRAM (A8)
1 #MAKE (A20/1:16)
1 #CV-REG-NUM (C)
1 #CV-CHASIS-NUM (C)
1 #CV-MAKE (C)
1 #CV-MODEL (C)
1 #CV-COLOUR (C)
1 #CV-YEAR (C) 
1 #CV-DATE-ACQ (C)
1 #CV-NAME (C)
1 #VEHICLE-COUNT (N1)
1 #TOTAL-VE (N1)
1 #CURRENT-YEAR (A18) 
1 REDEFINE #CURRENT-YEAR
2 #CURR-YEAR (A4)
1 #START-YEAR (N4) INIT <1886>
1 #START-DATE (N8) INIT <18860129>
1 #INDEX (N5)
END-DEFINE
#PROGRAM :=*PROGRAM
#CURRENT-YEAR := *DATN  /**(EM=YYYY/MM/DD) 
SET KEY 
  PF4 NAMED 'UPDAT'
MOVE (AD=P) TO 
  #CV-REG-NUM
  #CV-CHASIS-NUM
  #CV-MAKE
  #CV-MODEL
  
*   #CV-COLOUR
  #CV-YEAR 
  #CV-DATE-ACQ

FIND VIHICLES WITH PERSONEL-ID = #PERSONNEL-ID
  ADD 1 TO #VEHICLE-COUNT
  ADD 1 TO #INDEX
  MOVE *NUMBER TO  #TOTAL-VE 
  MOVE MAKE TO #MAKE(#INDEX)
  EMPLOYEES.PERSONEL-ID := #PERSONNEL-ID
 
  INPUT USING MAP "VHLST"
  IF *PF-KEY = 'PF4'
    MOVE (AD=I) TO
      #CV-REG-NUM
      #CV-CHASIS-NUM
      #CV-MAKE
      #CV-MODEL
*       #CV-COLOUR
      #CV-YEAR 
      #CV-DATE-ACQ
    INPUT USING MAP "VHLST"

    IF REG-NUM = ' '
      REINPUT ' REGISTRATION NUMBER CAN NOT BE LEFT BLANK !'
        MARK *REG-NUM
    END-IF
    IF CHASIS-NUM = ' '
      REINPUT ' CHASIS NUMBER CAN NOT BE LEFT BLANK !'
    END-IF

    IF MAKE = ' '
      REINPUT 'VEHICLE MAKE CAN NOT BE LEFT BLANK !'
        MARK *MAKE
    END-IF

    IF MODEL = ' '
      REINPUT ' VEHICLE MODEL CAN NOT BE LEFT BLANK !'
        MARK *MODEL
    END-IF

    IF COLOUR = ' '
      REINPUT 'VEHICLE COLOUR CAN NOT BE LEFT BLANK !'
    END-IF

  IF YEAR < #START-YEAR OR YEAR GT VAL(#CURR-YEAR)
    /**IF  YEAR (EM=9999) < YEAR (EM=9999)
      REINPUT ' YEAR IS INVALID OR YEAR EXCEED CURRENT YEAR !'
    END-IF

    IF DATE-ACQ < #START-DATE  OR DATE-ACQ GT VAL(#CURRENT-YEAR)
    REINPUT 'DATE AQCUIRED IS IN VALID OR IS GREATER THAN CURRENT DATE!'
        MARK *DATE-ACQ
    END-IF
    MOVE (AD=P) TO
      #CV-REG-NUM
      #CV-CHASIS-NUM
      #CV-MAKE
      #CV-MODEL
*       #CV-COLOUR
      #CV-YEAR
      #CV-DATE-ACQ
    INPUT WITH TEXT ' UPDATE WAS SUCCESSFUL !!' USING MAP "VHLST"

UPDATE
END OF TRANSACTION
  END-IF
END-FIND

IF #VEHICLE-COUNT = 0
  WRITE 'Personal ID:'#PERSONNEL-ID / 
    'Name:'7X #NAME /
    'EMPLOYEE DO NOT HAVE A VEHICLE'
END-IF
END
