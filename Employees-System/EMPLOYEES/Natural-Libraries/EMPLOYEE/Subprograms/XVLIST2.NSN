DEFINE DATA
PARAMETER
1 PERSONA-ID (A8)
* 1 #MAKE (A20/1:16)
* 1 #MODEL (A20/1:16)
* 1 #COLOUR (A10/1:16)
* 1 #CHASIS-NUM (B4/1:16)
LOCAL USING EMPL0L01
LOCAL USING VEH001
LOCAL
1 #V-PERSONEL-ID (A8/1:16) /* NC
1 #REG-NUM (A15/1:16)
1 #N@AC-1 (I2/1:16) /* INDICATOR OF AC-1
1 #YEAR (N4.0/1:16)
1 #CLASS (A1/1:16)
1 #LEASE-PUR (A1/1:16)
1 #DATE-ACQ (N8.0/1:16)
1 #MAINTAINANCE
  2 #CURR-CODE (A3/1:16)
  2 #MAINT-COST (P7.0/1:16,1:8)
/**
1 #SEL (A1/1:16)
1 #RESTART-NAME (A20)
1 #LATE-RESTART-NAME (A20)
1 #RES-NAME (A4/1:16)
1 #CITY (A20/1:16)
1 #NAME (A20/1:16)
1 #FIRST-NAME (A20/1:16)
1 #MIDDLE-I (A20)
1 #LANG (A3/1:5)
1 #PERSONNEL-ID (A8/1:16)
1 #ADDRESS-LINE (A20/1:2)
1 #INDEX (N10)
1 #INDEX1 (N10)
1 #INDEX11 (N10)
1 #INDEX2 (N10)
1 #PROGRAM (A8) 
1 #GENDER (A1)
1 #RESTART-NAME2 (A20)
1 #REPOS-FLAG (A1)
1 #G-DESCRIPTION (A10)
1 #S-DESCRIPTION (A10)
1 #MARITAL-STATUS (A1)
1 #MARITAL (A1)
1 #MESSAGE (A10)
/*PARAMETER
1 #MAKE (A20/1:16)
1 #MODEL (A20/1:16)
1 #COLOUR (A10/1:16)
1 #CHASIS-NUM (B4/1:16)

END-DEFINE

SET CONTROL 'MT'
MOVE *PROGRAM TO #PROGRAM

/**SETTING PF KEYS
SET KEY 
  PF1 = HELP
  PF3 NAMED 'Exit'
  PF8 NAMED 'Next'
/**
/*READ  WITH REPOSITION
#MESSAGE := 'no veh rec'
READ EMPLOYEES WITH REPOSITION BY PERSONEL-ID 
    STARTING FROM #RESTART-NAME2

  ADD 1 TO #INDEX
  MOVE PERSONEL-ID   TO #V-PERSONEL-ID (#INDEX)

/**
  IF #INDEX = 16
    REPEAT
*
      INPUT USING MAP "MENUVLST"

      DECIDE ON FIRST VALUE OF *PF-KEY
        VALUE 'PF3'
          ESCAPE MODULE
        VALUE 'ENTR'
          IGNORE
        VALUE 'PF8'
          ESCAPE BOTTOM
        NONE
          IGNORE/**REINPUT 'Enter a valid key !!!'
      END-DECIDE
/**
      FOR #INDEX1 = 1 TO 16
        DECIDE ON EVERY VALUE OF #SEL(#INDEX1)
*           VALUE 'A'
*             C ALLNAT "ADD" #PERSONNEL-ID (#INDEX1)
*             VALUE 'V'
*               CALLNAT "VEHLST"  #PERSONNEL-ID (#INDEX1) #NAME (#INDEX1)
          VALUE 'C'
          FETCH 'addeveh'
*             CALLNAT "XVLIST2" #V-PERSONEL-ID (#INDEX1)
*             RESET #SEL(#INDEX1)
          NONE
            IGNORE
        END-DECIDE

        FIND VIHICLES WITH PERSONEL-ID = #V-PERSONEL-ID (#INDEX)
      
          MOVE REG-NUM       TO #REG-NUM (#INDEX)
          MOVE N@AC-1        TO #N@AC-1(#INDEX)
          MOVE MAKE          TO #MAKE(#INDEX)
          MOVE MODEL         TO #MODEL (#INDEX)
          MOVE COLOUR        TO #COLOUR (#INDEX)
        END-FIND
      END-FOR
      /**

      /*
      IF  #RESTART-NAME NE ' '
        MOVE #RESTART-NAME TO #LATE-RESTART-NAME #RESTART-NAME2
        RESET  #RESTART-NAME
        RESET #INDEX
        MOVE 'Y' TO #REPOS-FLAG
        ESCAPE BOTTOM
      END-IF
      /**
    END-REPEAT
    /**
    RESET #INDEX1
    IF #REPOS-FLAG = 'Y'
      RESET #REPOS-FLAG
      ESCAPE TOP REPOSITION
    END-IF
  END-IF

END-READ
IF #INDEX LE 16


  RESET

    #V-PERSONEL-ID(#INDEX + 1:16)
    #REG-NUM (#INDEX + 1:16)

    #MAKE (#INDEX + 1:16)
    #N@AC-1(#INDEX + 1:16)
    #MODEL (#INDEX + 1:16)
    #COLOUR (#INDEX + 1:16)
    #SEL (#INDEX + 1:16)


  INPUT MARK *#RESTART-NAME

    USING MAP "MENUVLST"

END-IF

END
