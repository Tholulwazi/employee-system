* >Natural Source Header 000000
* :Mode S
* :CP
* <Natural Source Header
/** New Subprogram WRK41ADD.
/**
/** :author tzu
DEFINE DATA
LOCAL USING EMPL0L01
LOCAL USING VEH001
LOCAL
1 #PERSONEL-ID (A8)
1 #NAME (A20)
1 #MIDDLE-I (A20)
1 #FIRST-NAME (A20)
1 #G-DESCRIPTION (A10)
1 #S-DESCRIPTION (A10)
1 #START-DATE (N8) INIT <18860129>
1 #START-YEAR (N8) INIT <1886>
1 #CURRENT-YEAR (N8)
1 REDEFINE #CURRENT-YEAR 
  2 #CURR-YEAR (N4)
1 #LANG (A3/1:5)
1 #SELECT (A1/1:5)
1 #PROGRAM (A8)
1 #GENDER (A1)
1 #CV-ALL (C)
1 #CV-ID (C)
1 #MARITAL (A1)
1 #VEHICLE-COUNT(N3)
1 #TOTAL-VE (N3)
******************************************************************
/*INDEX
1 #INDEX (N3)
******************************************************************
END-DEFINE
* SET KEY
*   PF5 NAMED 'ADD'
* IF *PF-KEY = 'PF5'
#PROGRAM := *PROGRAM
#CURRENT-YEAR :=*DATN 

MOVE (AD=I) TO #CV-ID
INPUT USING MAP "VEH-ADD"

READ EMPLOYEES WITH PERSONEL-ID = #PERSONEL-ID
/*    INPUT USING MAP "VEH-ADD"
RESET #TOTAL-VE

  FIND (1) VIHICLES  WITH  PERSONEL-ID = EMPLOYEES.PERSONEL-ID
  
    #VEHICLE-COUNT:=*COUNTER
    IF #VEHICLE-COUNT > 0
      ADD 1 TO #TOTAL-VE
    END-IF

    INPUT USING MAP "VEH-ADD"

    IF REG-NUM = ' '
      REINPUT ' REGISTRATION NUMBER CAN NOT BE LEFT BLANK !'
        MARK *REG-NUM
    END-IF

    IF CHASIS-NUM = ' '
      REINPUT ' CHASIS NUMBER CAN NOT BE LEFT BLANK !'
        MARK *CHASIS-NUM
    END-IF

    IF MAKE = ' '
      REINPUT 'VEHICLE MAKE CAN NOT BE LEFT BLANK !'
        MARK *MAKE
    END-IF

    IF MODEL = ' '
      REINPUT ' VEHICLE MODEL CAN NOT BE LEFT BLANK !'
        MARK *MODEL
    END-IF

    IF COLOUR = ' '
      REINPUT 'VEHICLE COLOUR CAN NOT BE LEFT BLANK !'
        MARK *COLOUR
    END-IF

    IF YEAR < #START-YEAR OR YEAR GT #CURR-YEAR
      /**IF  YEAR (EM=9999) < YEAR (EM=9999)
      REINPUT ' YEAR IS INVALID OR YEAR EXCEED CURRENT YEAR !'
        MARK *YEAR
    END-IF

    IF DATE-ACQ < #START-DATE  OR DATE-ACQ GT #CURRENT-YEAR
    REINPUT 'DATE AQCUIRED IS IN VALID OR IS GREATER THAN CURRENT DATE!'
        MARK *DATE-ACQ
    END-IF
    MOVE (AD=I) TO #CV-ALL
    MOVE (AD=P) TO #CV-ID


*     UPDATE
*   END TRANSACTION
*   END-IF
  END-FIND
END-READ
* END-IF
END
