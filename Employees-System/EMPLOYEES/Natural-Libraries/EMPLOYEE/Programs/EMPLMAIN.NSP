/** :author tzu
/* MAINPROGRAM THAT STARTUP THE EMPLOYEE SYSTEM
DEFINE DATA LOCAL
LOCAL USING EMPL0L01
LOCAL USING VEH001
LOCAL
************************************************************
1 #PERSONNEL-ID (A8)
1 #NAME (A20)
1 #PROGRAM (A8)
1 #RESTART-NAME (A20)
1 #RESTART-NAME2 (A20)
1 #LATE-RESTART-NAME (A20)
1 #REPOS-FLAG (A1)
1 #INDEX (N4)
1 #INDEX1 (N4)
1 #CURRENT-YEAR (A18) 
1 REDEFINE #CURRENT-YEAR
  2 #CURR-YEAR (A4)
1 #LAST-DATE-MODIFIED (A18)
1 #DATE (A18)
1 REDEFINE #DATE
  2 #TIME (A5)
1 #G-MASSAGE (A20)
1 #SEL (A1/1:4)
1 #I-SEL (N5)
1 #Q-MESSAGE (A30)
1 #EXIT (A1)
1 #V-PERSONEL-ID (A8/1:16) 
1 PERSONA-ID (A8)
END-DEFINE
SET CONTROL 'MT'
SET KEY
  PF3 NAMED 'EXIT'
  PF1 = HELP


#PROGRAM := *PROGRAM
#LAST-DATE-MODIFIED := *DATX
#CURRENT-YEAR := *DATG
#DATE := *TIME 
REPEAT
UNTIL #SEL(4) = 'Q'
  INPUT USING MAP "XXXMENU"
  IF *PF-KEY = 'PF3'
    ESCAPE MODULE
  END-IF
  IF *PF-KEY = 'PF1'
    INPUT USING MAP "XMENUHLP"
  END-IF


*   FOR #I-SEL= 1 TO 4
    DECIDE FOR FIRST CONDITION
      WHEN #SEL(1) = 'e' OR #SEL(1) = 'E'
        CALLNAT "XELIST" 
      WHEN #SEL(2) = 'v' OR #SEL(2) = 'V'
        /*FETCH 'addeveh'
        CALLNAT "XVLIST2" PERSONA-ID
      WHEN #SEL(3) = 's' OR #SEL(3) = 'S'
        CALLNAT "XELIST"
*         FETCH RETURN "TEST"
      WHEN #SEL(4) = 'q' OR #SEL(4) = 'Q'
        CALLNAT "XEXIT" #Q-MESSAGE #EXIT
      WHEN NONE 
        IGNORE
*         REINPUT 'Select  a VALID INPUT !!!'
    END-DECIDE
    RESET #SEL(#I-SEL)
*   END-FOR


END-REPEAT


END
