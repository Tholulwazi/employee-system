* >Natural Source Header 000000
* :Mode S
* :CP
* <Natural Source Header
/** New Program SAL-RY.
/**
/** :author tzu
/* PROGRAM THAT CALLS FUNCTION FOR SALARY
DEFINE DATA LOCAL
LOCAL USING EMPL0L01 
LOCAL 
1 #PROGRAM (A8)                                              
1 #PERCENT (N2.2) 
1 #OLD-SALARY (N9.2)
1 #PERSONEL-ID (A8)
1 #NEW-SALARY (P9.3) /*RETURNS
1 #NEW-SALRY (P9.3) /*RETURNS
1 #INDEX (N5)
1 #PERCNT (A4)
1 #CV-ALL (C)
END-DEFINE
SET KEY
  PF3 NAMED 'EXIT'
#PROGRAM:=*PROGRAM
MOVE (AD=I) TO #CV-ALL
* #PERSONEL-ID:= '30000231'
INPUT #PERSONEL-ID
* INPUT USING MAP 'sal-incr'
FIND EMPLOYEES WITH PERSONEL-ID =#PERSONEL-ID
*
  INPUT USING MAP 'sal-incr'
  IF *PF-KEY = 'PF3'
    ESCAPE BOTTOM
  END-IF
*  
  IF #PERCNT EQ ' '
    REINPUT FULL 'Increase percent can not be less than Zero'
      MARK *#PERCNT
  END-IF

  IF #PERCNT IS (N4)
    #PERCENT:= VAL(#PERCNT)  /** (EM=Z9.99)
  END-IF

  #OLD-SALARY := SALARY(1)
  #NEW-SALRY := SALARY (<#PERCENT,#OLD-SALARY>)


  FOR #INDEX = 4 TO 1 -1
    MOVE SALARY(#INDEX) TO SALARY (#INDEX+1)
  END-FOR

  MOVE #NEW-SALRY TO SALARY (1)
  MOVE #PERCENT TO #PERCNT
  MOVE (AD=P) TO #CV-ALL
  INPUT USING MAP 'sal-incr'
  /* WRITE #OLD-SALARY #NEW-SALARY
  UPDATE
 END OF TRANSACTION
END-FIND
END
