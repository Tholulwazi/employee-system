* :Mode S
* :CP
* <Natural Source Header
/** New Subprogram BONUS1.
/** READ A AN EXTENAL FILE FOR BONUSES
/** :author tzu
DEFINE DATA

LOCAL USING EMPL0L01
LOCAL
1 BONUS-INFO (A20)
1 #PERSONNEL-ID (A8)
1 #BONUS (A9)
1 REDEFINE #BONUS 
  2 #BONUS1 (N9)
1 #PERSONEL-ID (A8)
1 #NAME (A20)
1 #BONUS-FINAL (N9)
1 #MIDDLE-I (A20)
1 #FIRST-NAME (A20)
1 #G-DESCRIPTION (A10)
1 #S-DESCRIPTION (A10)
* 1 EMPLOYEES 
*   2 PERSONEL-ID (A8) /* CNNNNNNN
*   2 FIRST-NAME (A20) /* FIRST / CHRISTIAN NAME
*   2 MIDDLE-I (A20) /* MIDDLE INITIAL
*   2 NAME (A20) /* SURNAME / FAMILY NAME
*   2 MAR-STAT (A20) /* M=MARRIED
*   2 GENDER (A1)
*   2 LANG (A3/1:5) /* LANGUAGES SPOKEN

1 #LANG (A3/1:5)
1 #SELECT (A1/1:5)
1 #PROGRAM (A8)
1 #GENDER (A1)
1 #CV-ALL (C)
1 #CV-ID (C)
1 #MARITAL (A1)
1 #COUNTER (N5)
******************************************************************
/*INDEX
1 #INDEX (N3)
1 #BONUS-INDEX (N3)
******************************************************************
END-DEFINE
FORMAT LS=79 PS=20
SET KEY
  PF3 NAMED 'EXIT'
#PROGRAM := *PROGRAM
DEFINE WORK FILE 1
  "C:\TRAININGS\BONUS FILE\SALES BONUS.TXT"
DEFINE WORK FILE 2
  "C:\TRAININGS\BONUS FILE\SALES BONUS UPDATED.TXT"
  TYPE 'CSV'
AT TOP OF PAGE
  WRITE 'PROGRAM: ' *PROGRAM 10X 'DATE: ' *DATG /
    'EMPLOYEES WHO RECEIVED BONUS FOR THE MONTH: ' *DATX (EM=L(10))
END-TOPPAGE
AT END OF PAGE
  WRITE '*' 'EMPLOYEES RECEIVED BONUS: '#COUNTER /
  WRITE 'PAGE: '*PAGE-NUMBER
END-ENDPAGE

WRITE WORK FILE 2 VARIABLE 'COUNTER'
  'PERSONNEL-ID'
  '#BONUS TO BE UPD'
  'UPDATED BONUS'

READ WORK FILE 1 #PERSONNEL-ID #BONUS 
  ADD 1 TO #COUNTER


  FIND EMPLOYEES  WITH  PERSONEL-ID = #PERSONNEL-ID

    FOR #BONUS-INDEX = 4 TO 1 
        STEP -1
/*UPDATE BONUS 
      MOVE BONUS(1,#BONUS-INDEX)
        TO BONUS(1,#BONUS-INDEX + 1)
    END-FOR


    MOVE #BONUS1 TO BONUS(1,1)

*     FOR #INDEX = 1 TO 5
    WRITE WORK FILE 2 VARIABLE #COUNTER
      #PERSONNEL-ID
      #BONUS1
      BONUS(1,1)
      BONUS(1,2)
      BONUS(1,3)
      BONUS(1,4)
      BONUS(1,5)
*     END-FOR
*       EMPLOYEES.PERSONEL-ID

*     UPDATE
*   END TRANSACTION
*   END-IF
  END-FIND
END-WORK
CLOSE WORK FILE 1
*    INPUT WITH TEXT 'BONUS UPDATE WAS SUCCESSFUL !!'USING MAP "BONUS"
WRITE 'NUMBER OF EMPLOYEES RECEIVED BONUS : ' #COUNTER
ON ERROR 
  WRITE '='#PERSONNEL-ID '='#BONUS 
END-ERROR
END
