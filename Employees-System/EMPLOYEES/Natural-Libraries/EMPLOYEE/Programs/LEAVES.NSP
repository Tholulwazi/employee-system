/** New Program EMPLMAIN.
/**
/** :author tzu
/* TODO Enter your code here
DEFINE DATA LOCAL
LOCAL USING EMPL0L01
* LOCAL USING VEH001
LOCAL
* 1 EMPLOYEES VIEW OF EMPLOYEES
* ************************************************************
* 1 PERSONEL-ID (A8)
* 1 LEAVE-BOOKED (1:4) /* VACATION PLANNED
*   2 LEAVE-START (N8.0) /* FIRST VECATION DAY
*   2 REDEFINE LEAVE-START 
*     3 L-START (N4) /* FIRST VECATION DAY
*   2 LEAVE-END (N8.0)
*   2 REDEFINE LEAVE-END
*     3 L-END (N4) /* LAST VACATION DAY
1 #I (N2)
1 #DATE-START (D/1:4)
1 #DATE-END (D/1:4)
1 #PROGRAM (A8)
1 #YEAR (N4) INIT <2025>
1 #COUNT-REC (N6)
END-DEFINE
SET CONTROL 'MT'
SET KEY
  PF3 NAMED 'EXIT'
  PF1 = HELP
#PROGRAM := *PROGRAM
*     3 LEAVE-START (N8.0) /* FIRST VECATION DAY
*     3 REDEFINE LEAVE-START 
*     4 L-START (A4) /* FIRST VECATION DAY
*     3 LEAVE-END (N8.0) /* LAST VACATION DAY
*     3 REDEFINE LEAVE-END 
*     4 L-END (A4) /* LAST VACATION DAY

READ  EMPLOYEES  ASCENDING BY PERSONEL-ID
  FOR #I = 1 TO 4
   IF LEAVE-START (#I) > 0 OR LEAVE-END(#I) > 0
      MOVE #YEAR TO L-START-YEAR(#I)
      MOVE #YEAR TO L-END-YEAR(#I)
    END-IF
    ADD 1 TO #COUNT-REC
    

*     DISPLAY PERSONEL-ID 
*     VERT AS  'leave days'  LEAVE-START(#I)  LEAVE-END(#I)

  END-FOR

UPDATE
 
* 
  END OF TRANSACTION
END-READ
WRITE 'Number of Rec Updated' #COUNT-REC

END
