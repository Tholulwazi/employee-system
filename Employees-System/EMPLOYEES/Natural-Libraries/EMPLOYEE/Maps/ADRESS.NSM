1 EMPLOYEES.CITY (A020)
1 EMPLOYEES.COUNTRY (A003)
1 EMPLOYEES.NAME (A020)
1 EMPLOYEES.PERSONEL-ID (A008)
1 EMPLOYEES.PHONE (A015)
1 EMPLOYEES.POST-CODE (A010)
END-DEFINE
FORMAT PS=024 LS=080 ZP=OFF SG=OFF KD=OFF IP=OFF
* MAP2: MAP PROFILES *****************************        200***********
