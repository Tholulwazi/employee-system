* INPUT USING MAP 'XXXXXXXX'
*     #CV-CHASIS-NUM #CV-COLOUR #CV-DATE-ACQ #CV-MAKE #CV-MODEL #CV-REG-NUM
*     #CV-YEAR #NAME #PROGRAM #TOTAL-VE #VEHICLE-COUNT VIHICLES.CHASIS-NUM
*     VIHICLES.COLOUR VIHICLES.DATE-ACQ VIHICLES.MAKE VIHICLES.MODEL VIHICLES.PERSONEL-ID
*     VIHICLES.REG-NUM VIHICLES.YEAR
DEFINE DATA PARAMETER
1  #CV-CHASIS-NUM (C)
1  #CV-COLOUR (C)
1  #CV-DATE-ACQ (C)
1  #CV-MAKE (C)
1  #CV-MODEL (C)
1  #CV-REG-NUM (C)
1  #CV-YEAR (C)
1 #NAME (A020)
1 #PROGRAM (A008)
1 #TOTAL-VE (N01.0)
1 #VEHICLE-COUNT (N01.0)
1 VIHICLES.CHASIS-NUM (B004)
1 VIHICLES.COLOUR (A010)
1 VIHICLES.DATE-ACQ (N08.0)
1 VIHICLES.MAKE (A020)
1 VIHICLES.MODEL (A020)
1 VIHICLES.PERSONEL-ID (A008)
1 VIHICLES.REG-NUM (A015)
1 VIHICLES.YEAR (N04.0)
END-DEFINE
FORMAT PS=024 LS=080 ZP=OFF SG=OFF KD=OFF IP=OFF
* MAP2: MAP PROFILES *****************************        200***********
* .TTAAAMMOO   D I D I N D I D I        ?_)^&:+(                       *
* 024079        N0NNUCN             X        01 SYSPROF NR             *
************************************************************************
INPUT          (     IP=OFF                                           /*
                                                                       )
 001T 'PROGRAM:'
