/
 001T 'Year:'
 023T VIHICLES.YEAR /*.99U004 N04.0.
      (AD=MDLT CV=#CV-YEAR )
/
 001T 'Chasis Number:'
 023T VIHICLES.CHASIS-NUM /*.99U008 B004 .
      (AD=MDLT CV=#CV-CHASIS-NUM )
/
 001T 'Date Acquired:'
 023T VIHICLES.DATE-ACQ /*.99U008 N08.0.
      (AD=MDLT CV=#CV-DATE-ACQ )
/
 001T 'Vehicle Count:'
 024T #VEHICLE-COUNT /*.01U001 N01.0.
      (AD=OURT CD=BL )
 026T 'Of'
 029T #TOTAL-VE /*.01U001 N01.0.
      (AD=OULT CD=TU )
/
/
