      (AD=ODT )
 065T *DATG /*.01S010 A015 .
      (AD=ODT AL=010 )
/
 001T 'MAP NAME:'
 011T *PROGRAM /*.01S008 A008 .
      (AD=ODT )
 066T *TIME /*.01S008 A010 .
      (AD=ODT AL=008 )
/
 026T 'EMPLOYEE VEHICLE DETAILS'
/
/
 001T 'Personal ID:'
 023T VIHICLES.PERSONEL-ID /*.01U008 A008 .
      (AD=ODLT )
/
 001T 'Surname:'
