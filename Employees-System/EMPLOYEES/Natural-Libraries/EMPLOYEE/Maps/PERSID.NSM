1 #PROGRAM (A008)
1 EMPLOYEES.FIRST-NAME (A020)
1 EMPLOYEES.NAME (A020)
END-DEFINE
FORMAT PS=012 LS=051 ZP=OFF SG=OFF KD=OFF IP=OFF
* MAP2: MAP PROFILES *****************************        200***********
* .TTAAAMMOO   D I D I N D I D I        ?_)^&:+(                       *
* 012050        N0NNUCN             X ^      01 SYSPROF NR             *
************************************************************************
