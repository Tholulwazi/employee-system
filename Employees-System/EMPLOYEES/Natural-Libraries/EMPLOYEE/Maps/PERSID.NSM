                                                                       )
 002T 'PROGRAM:'
 011T #PROGRAM /*.01U008 A008 .
      (AD=ODT )
 032T *DATG /*.01S014 A015 .
      (AD=ODT AL=014 )
/
 033T *TIME /*.01S010 A010 .
      (AD=ODT )
/
/
 003T 'Employee was added Successful !    '
/
/
 003T 'Name:'
 025T EMPLOYEES.FIRST-NAME /*.01U020 A020 .
      (AD=OULT )
/
 003T 'Surname:'
