*     #NAME #PERSONNEL-ID #PROGRAM #S-DESCRIPTION
DEFINE DATA PARAMETER
1  #CV-ALL (C)
1 #FIRST-NAME (A020)
1 #G-DESCRIPTION (A010)
1 #GENDER (A001)
1 #LANG (A003/00001:00005)
1 #MARITAL (A001)
1 #MIDDLE-I (A020)
1 #NAME (A020)
1 #PERSONNEL-ID (N08.0)
1 #PROGRAM (A008)
1 #S-DESCRIPTION (A010)
END-DEFINE
FORMAT PS=024 LS=080 ZP=OFF SG=OFF KD=OFF IP=OFF
* MAP2: MAP PROFILES *****************************        200***********
* .TTAAAMMOO   D I D I N D I D I        ?_)^&:+(                       *
* 024079        N0NNUCN             X        01 SYSPROF NR             *
************************************************************************
INPUT          (     IP=OFF                                           /*
                                                                       )
 001T 'PROGRAM :'
 011T #PROGRAM /*.01U008 A008 .
      (AD=ODT )
 030T 'HR Information System'
