      (AD=MDLT CV=#CV-ALL )
/
/
 002T 'Gender:'
 020T #GENDER /*.99D001 A001 .
      (AD=MDRT CV=#CV-ALL HE='GENHELP',#G-DESCRIPTION )
 022T #G-DESCRIPTION /*.99D010 A010 .
      (AD=MDLT CV=#CV-ALL )
/
 002T 'Marital Status:'
 020T #MARITAL /*.99D001 A001 .
      (AD=MDRT CV=#CV-ALL HE='MARTHELP',#S-DESCRIPTION )
 022T #S-DESCRIPTION /*.99D010 A010 .
